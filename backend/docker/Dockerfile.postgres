FROM postgres:16-alpine

# Install pgvector extension v0.7.4
RUN apk add --no-cache --virtual .build-deps \
    build-base \
    git \
    postgresql-dev \
    && cd /tmp \
    && git clone --branch v0.7.4 https://github.com/pgvector/pgvector.git \
    && cd pgvector \
    && make clean \
    && make OPTFLAGS="" vector.so \
    && cp sql/vector.sql sql/vector--0.7.4.sql \
    && mkdir -p /usr/local/lib/postgresql /usr/local/share/postgresql/extension /usr/local/include/postgresql/server/extension/vector \
    && install -m 755 vector.so /usr/local/lib/postgresql/vector.so \
    && install -m 644 vector.control /usr/local/share/postgresql/extension/ \
    && install -m 644 sql/*.sql /usr/local/share/postgresql/extension/ \
    && install -m 644 src/halfvec.h src/sparsevec.h src/vector.h /usr/local/include/postgresql/server/extension/vector/ \
    && cd / \
    && rm -rf /tmp/pgvector \
    && apk del .build-deps

# Copy init script and ensure LF endings
COPY init-db.sh /docker-entrypoint-initdb.d/init-db.sh

# Ensure LF endings and make executable
RUN sed -i 's/\r$//' /docker-entrypoint-initdb.d/init-db.sh && \
    chmod +x /docker-entrypoint-initdb.d/init-db.sh
