# Embedding Worker - OpenAI embeddings generation
FROM python:3.12-slim

WORKDIR /app/backend

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY backend/pyproject.toml backend/README.md ./

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Copy application code
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini

# Create non-root user
RUN useradd -m -u 1000 worker && \
    chown -R worker:worker /app
USER worker

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "from app.workers.tasks.embedding import check_worker_health; exit(0 if check_worker_health('embedding_generation') else 1)"

# Default command: RQ worker for embedding_generation queue
CMD ["rq", "worker", "embedding_generation", "--url", "${REDIS_URL}"]
