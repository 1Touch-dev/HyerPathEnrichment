# ─────────────────────────────────────────────
# Core (required today)
# ─────────────────────────────────────────────
# Quote values that contain spaces (required if this file is sourced or used as a Docker env_file).
APP_NAME="Hyrepath Enrichment Backend"
APP_ENV=development
API_TOKEN=change-me
# Staging/production refuse to start if API_TOKEN remains a default (change-me, etc.).
# Optional dedicated scrape secret for GET /metrics (falls back to API_TOKEN when empty).
# In staging/production /metrics always requires auth even if this is empty.
# METRICS_TOKEN=

# Logging — empty LOG_FORMAT = auto (json when APP_ENV is staging|production, else text)
# LOG_FORMAT=text
# LOG_LEVEL=INFO
# LOG_SERVICE=hyrepath-enrichment

# Local dev (default): single-process SQLite
DATABASE_URL=sqlite+aiosqlite:///./hyrepath.db
# Docker / production: shared Postgres so API + worker see the same jobs.
# `cd backend/docker && docker compose up -d postgres` starts a local Postgres 16 +
# pgvector container (see docker/Dockerfile.postgres). It reads POSTGRES_PASSWORD
# from backend/docker/.env (gitignored, not this file). Host-side processes
# (uvicorn/pytest run outside Docker) connect via 127.0.0.1:5433; containers on
# the compose network use `postgres:5432` instead.
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+asyncpg://hyrepath:change-me@127.0.0.1:5433/hyrepath
# Separate DB for `pytest -m postgres` so test runs never touch dev data.
# TEST_DATABASE_URL=postgresql+asyncpg://hyrepath:change-me@127.0.0.1:5433/hyrepath_test

REDIS_URL=redis://localhost:6379/0
R2_BUCKET=hyrepath-assets
R2_PUBLIC_BASE_URL=https://cdn.example.com

# TTLs + rate limits
LINKEDIN_PHOTO_TTL_SECONDS=86400
USERNAME_LOOKUP_TTL_SECONDS=3600
BUSINESS_LOOKUP_TTL_SECONDS=3600
JOB_LOOKUP_TTL_SECONDS=1800
MAX_SYNC_REQUESTS_PER_MINUTE=10
MAX_ASYNC_REQUESTS_PER_MINUTE=30
MAX_COMPLIANCE_REQUESTS_PER_MINUTE=20
MAX_AUTH_REQUESTS_PER_MINUTE=5
MAX_DOCUMENTS_UPLOAD_REQUESTS_PER_MINUTE=10
MAX_SIGNALS_WEBHOOK_REQUESTS_PER_MINUTE=30
MAX_JOB_MATCHING_SCAN_REQUESTS_PER_MINUTE=5
MAX_ADMIN_IMPERSONATION_START_REQUESTS_PER_MINUTE=5
MAX_ADMIN_MFA_VERIFY_REQUESTS_PER_MINUTE=5
MAX_ADMIN_REVIEW_QUEUE_DECIDE_REQUESTS_PER_MINUTE=30
MAX_ADMIN_MODERATION_REQUESTS_PER_MINUTE=30
MAX_QUESTIONS_REQUESTS_PER_MINUTE=20
MAX_PRACTICE_AUDIO_UPLOAD_REQUESTS_PER_MINUTE=10
MAX_JD_PRACTICE_REQUESTS_PER_MINUTE=20
MAX_APPLICATION_TRACKER_STATUS_UPDATE_REQUESTS_PER_MINUTE=30
MAX_INTERVIEW_SCHEDULING_REQUESTS_PER_MINUTE=20
MAX_MANUAL_JOB_ENTRY_CREATE_REQUESTS_PER_MINUTE=20
MAX_OUTREACH_SEND_REQUESTS_PER_MINUTE=20
MAX_JOB_MATCHING_APPLY_REQUESTS_PER_MINUTE=30

# Compliance — audit log retention (years)
AUDIT_LOG_RETENTION_YEARS=5

# ─────────────────────────────────────────────
# Direct OpenAI usage (Week 1/2 AI features — separate from LLM_MODE below)
# Required for: CV extraction (cv_extractor.py), embeddings (embeddings.py),
# Whisper transcription (clients/speech.py), interview question generation
# (question_generator.py), interview feedback (feedback_generator.py).
# These call api.openai.com directly and do NOT go through LLM_MODE/LiteLLM
# (see backend/docs/ARCHITECTURE.md "Do not assume" table).
# Unset -> every one of the features above raises "OpenAI API key not configured".
# ─────────────────────────────────────────────
OPENAI_API_KEY=

# Budget monitoring
DAILY_COST_THRESHOLD_USD=100.0
MONTHLY_COST_THRESHOLD_USD=2000.0
ENABLE_BUDGET_ALERTS=true

# ─────────────────────────────────────────────
# Authentication (Phase 4)
# ─────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Staging/production refuse to start if SECRET_KEY is a default or shorter than 32 chars.
# JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (get credentials from Google Cloud Console)
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-secret
# GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/callback/google

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:3000

# CORS allowlist — comma-separated origins for browser-based clients. Optional: when
# unset, falls back to FRONTEND_URL (or http://localhost:3000) so single-origin setups
# keep working unchanged. Only set this if you need multiple allowed origins, e.g.:
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# Cookie settings (COOKIE_SECURE=true is required when APP_ENV is staging|production)
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com

# Email service (SendGrid) — required for email verification
EMAIL_ENABLED=false
EMAIL_TEST_MODE=true
# SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@hyrepath.com
SENDGRID_FROM_NAME="Hyrepath Enrichment"
SENDGRID_REPLY_TO=support@hyrepath.com

# ─────────────────────────────────────────────
# Provider mode switches (Phase 0)
# These 5 flags are the ONLY thing that changes free -> paid.
# Defaults = fully free / self-hosted.
# ─────────────────────────────────────────────
# none | scrapoxy | paid
PROXY_MODE=none
# local | multilogin
BROWSER_MODE=local
# stub | ollama | litellm
LLM_MODE=stub
# basic (syntax+MX) | smtp (Reacher)
EMAIL_VERIFY_LEVEL=basic
# LinkedIn off by default (hardest to do free)
ENABLE_TIER1=false

# ─────────────────────────────────────────────
# Tier 1 — LinkedIn photo (Phase 3, Multilogin + Selenium)
# Only used when ENABLE_TIER1=true on the worker (not API container).
#
# Docker: secrets are injected by docker-compose.tier1.yml via env_file
# (default ../.env, or WORKER_ENV_FILE=/path/to/worker.env in production).
# Do not put inline # comments on secret value lines — Docker env-files
# treat the comment as part of the value.
#
#   cd backend/docker
#   docker compose -f docker-compose.yml -f docker-compose.tier1.yml up -d worker
# ─────────────────────────────────────────────
# MULTILOGIN_API_URL=https://api.multilogin.com
# Host probes: leave as launcher.mlx.yt (resolves to local agent). Docker Tier 1
# maps launcher.mlx.yt -> host-gateway (or MULTILOGIN_HOST_IP on WSL2 + Docker
# Engine) in docker-compose.tier1.yml — do not change this URL just for containers.
# On bare Linux (--with-linux-mlx) docker-compose.multilogin.yml overrides this
# to https://127.0.0.1:45001/api/v2 automatically.
# MULTILOGIN_LAUNCHER_URL=https://launcher.mlx.yt:45001/api/v2
# Linux bare-metal: build args for docker-compose.multilogin.yml. Used at image
# build time only to pull mlxapp.deb from S3; no runtime AWS access is required.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# Set to "true" to have start_production.sh auto-load docker-compose.multilogin.yml
# ENABLE_LINUX_MLX=false
# MULTILOGIN_EMAIL=
# MULTILOGIN_PASSWORD=
# MULTILOGIN_FOLDER_ID=
# MULTILOGIN_WORKSPACE_ID=
# MULTILOGIN_PROFILE_ID=
# MULTILOGIN_PROFILE_POOL_SIZE=0
# MULTILOGIN_DAILY_VIEW_LIMIT=22
# Selenium host for the RQ worker connecting to Multilogin's ChromeDriver debug port.
# Dev (WSL native worker, mlxapp on Windows host): http://127.0.0.1
#   The worker process must run natively in WSL — not in Docker — so it shares the
#   same 127.0.0.1 as Windows. See docs/DEV_SETUP_WSL.md for the full dev topology.
# Production (docker-compose.multilogin.yml): that overlay sets http://127.0.0.1 via
#   network_mode: host automatically — do not override it here for Linux prod.
# docker-compose.tier1.yml (WSL2+Docker worker path): overrides to http://launcher.mlx.yt
#   (launcher API only; Selenium debug port is still unreachable from Docker on Windows).
# Legacy hardcoded bridge IP (e.g. https://172.26.x.x) — broken, do not use.
# MULTILOGIN_SELENIUM_HOST=http://127.0.0.1
# If HTTP(S)_PROXY is set, bypass Multilogin (proxy POST to api.multilogin.com can 501):
# NO_PROXY=127.0.0.1,::1,localhost,api.multilogin.com,launcher.mlx.yt
# no_proxy=127.0.0.1,::1,localhost,api.multilogin.com,launcher.mlx.yt
# LINKEDIN_BOT_EMAIL=
# LINKEDIN_BOT_PASSWORD=
# TIER1_BROWSER_TIMEOUT_SECONDS=45

# ——————————————————————————————————————————————————————————————————————————————
# RQ Job Timeout
# ——————————————————————————————————————————————————————————————————————————————
# Maximum job execution time in seconds. Must accommodate full all-tier enrichment.
# Typical single-profile all-tier run: 20-30 minutes. Default: 3000s (50 min).
# RQ_JOB_TIMEOUT_SECONDS=3000
# TIER1_MAX_CONCURRENT_BROWSERS=1
# TIER1_SKIP_LOGIN_IF_SESSION_VALID=true
# TIER1_PLACEHOLDER_DENYLIST=custom-fragment,another-fragment
# MULTILOGIN_PROFILE_COOLDOWN_SECONDS=86400
# MULTILOGIN_RATE_LIMIT_COOLDOWN_SECONDS=3600
# Legacy Playwright CDP attach (optional local dev)
# MULTILOGIN_CDP_URL=http://host.docker.internal:45001
# R2 real credentials (leave unset in development -> writes to .asset-cache/)
# Required when APP_ENV=production|staging and ENABLE_TIER1=true (worker fail-fast)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────
# Tier 2 — Handle hunt (Phase 1/2, free)
# ─────────────────────────────────────────────
# social-analyzer sidecar (free, AGPL, isolated). Unset -> empty fragment.
# SOCIAL_ANALYZER_URL=http://social-analyzer:9005
SHERLOCK_TIMEOUT_SECONDS=60
MAIGRET_TIMEOUT_SECONDS=180

# ─────────────────────────────────────────────
# Tier 3 — OSINT + email (Phase 1 free, Phase 3 paid SMTP)
# ─────────────────────────────────────────────
# gitrecon / theHarvester: free GitHub token (higher rate limits, still free)
GITHUB_TOKEN=
GITRECON_SCRIPT=
# gitrecon GitHub throttle (Redis fixed-window + cooldown after 403/429)
GITRECON_MAX_PER_MINUTE=10
GITRECON_RATE_LIMIT_BACKOFF_SECONDS=5
GITRECON_COOLDOWN_SECONDS=60
THEHARVESTER_TIMEOUT_SECONDS=120
CROSSLINKED_TIMEOUT_SECONDS=120
CROSSLINKED_SEARCH_ENGINES=yahoo

# email-sleuth Rust binary (subprocess); falls back to local pattern gen if unset
EMAIL_SLEUTH_BIN=email-sleuth

# email-verifier (AfterShip, free) — used in basic mode. Unset -> MX-only fallback.
# EMAIL_VERIFIER_URL=http://email-verifier:8080

# Verification batch limits (Tier 3 two-phase pipeline)
EMAIL_VERIFY_MAX_PER_JOB=10
EMAIL_VERIFY_SMTP_DELAY_SECONDS=6

# Reacher SMTP verify (Phase 3, needs port 25 + clean IP).
# Only used when EMAIL_VERIFY_LEVEL=smtp
# REACHER_URL=http://reacher:8080
# REACHER_FROM_EMAIL=verify@yourdomain.com

# ─────────────────────────────────────────────
# Tier 4 — Jobs + business (Phase 1/2, free)
# ─────────────────────────────────────────────
JOBSPY_RESULTS_PER_BOARD=15
# Job source provider: jobspy (free, unreliable scraping) | jsearch (paid RapidAPI, reliable)
JOB_SOURCE_PROVIDER=jobspy
# JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com
JSEARCH_NUM_PAGES=1
JSEARCH_TIMEOUT_SECONDS=20.0
# google-maps-scraper sidecar (-web mode). Unset -> empty fragment.
# GMAPS_SCRAPER_URL=http://google-maps-scraper:8080
GMAPS_JOB_TIMEOUT_SECONDS=300
GMAPS_JOB_POLL_SECONDS=10

# ─────────────────────────────────────────────
# LLM disambiguation (Phase 3/4)
# Free now: LLM_MODE=stub (no keys) or ollama (local). Paid: litellm.
#
# Multi-provider fallback: start the middleman, then point the app at it:
#   cd backend/docker && docker compose --profile llm up -d litellm
# Vendor keys below are passed into the litellm container via compose
# interpolation (`docker compose --env-file ../.env --profile llm up`).
# The litellm service does not env_file the whole .env (Hyrepath DATABASE_URL
# would crash-loop the proxy). Model routing uses docker/litellm_config.yaml.
# (api/worker never need OPENAI_API_KEY / GEMINI_API_KEY *for the LiteLLM proxy
# path specifically* — but see the "Direct OpenAI usage" block near the top of
# this file: several Week 1/2 AI features call api.openai.com directly and DO
# need OPENAI_API_KEY set regardless of LLM_MODE).
# ─────────────────────────────────────────────
LLM_MODE=stub
DISAMBIGUATION_THRESHOLD=0.7
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.1
# LiteLLM proxy — only used when LLM_MODE=litellm
# LITELLM_API_BASE=http://litellm:4000
# Host-native API outside Docker: LITELLM_API_BASE=http://localhost:4000
# LITELLM_API_KEY=
# LITELLM_MASTER_KEY=
# LITELLM_MODEL=gpt-4o-mini
# LITELLM_FALLBACKS=gemini/gemini-2.5-flash
# Vendor keys — for litellm via: docker compose --env-file ../.env --profile llm up
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ─────────────────────────────────────────────
# Proxies (Phase 3, paid-later)
# Only used when PROXY_MODE=scrapoxy|paid
# ─────────────────────────────────────────────
# SCRAPOXY_URL=http://scrapoxy:8888
# SCRAPOXY_USERNAME=
# SCRAPOXY_PASSWORD=

# ─────────────────────────────────────────────
# Observability + signals (Phase 4, free self-host)
# ─────────────────────────────────────────────
# LANGFUSE_HOST=http://langfuse:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# CHANGEDETECTION_URL=http://changedetection:5000
# CHANGEDETECTION_API_KEY=  # required in staging/production (signals webhook fail-closed)
# Optional outbound webhook for change signals (Slack, Discord, custom JSON API).
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/changes
# Apprise URL used when creating watches (Docker default posts to the API).
# CHANGEDETECTION_SIGNAL_URL=post://api:8000/api/signals/changedetection
#
# Central error tracking (GlitchTip under --profile observability, or Sentry SaaS)
# SENTRY_DSN=http://public_key@glitchtip-web:8000/1
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_SEND_DEFAULT_PII=false
# E2E only — POST /internal/error-tracking-probe (never enable in production)
# ENABLE_ERROR_TRACKING_PROBE=false
# GLITCHTIP_PUBLIC_URL=http://localhost:8001
# GLITCHTIP_SECRET_KEY=change-me-glitchtip-secret

# ─────────────────────────────────────────────
# Module 1: AI Job Matching & Notifications
# ─────────────────────────────────────────────
JOB_MATCHING_ENABLED=true
JOB_MATCHING_SCAN_CRON=0 6 * * *          # daily at 06:00 UTC, staggered internally (see §7)
JOB_MATCHING_MAX_POSTINGS_PER_SCAN=50     # JobSpy results_wanted per candidate scan
JOB_MATCHING_SIMILARITY_THRESHOLD=0.5     # pgvector cosine similarity floor, matches vector_search.py default
JOB_MATCHING_TOP_N_EXPLANATIONS=5         # LLM explanation calls per candidate per scan, per Decision 1
JOB_MATCHING_INACTIVE_AFTER_DAYS=14       # job_postings.is_active sweep threshold
JOB_MATCHING_EXPLANATION_MAX_RETRIES=3    # explanation_status retry cap before marking a match 'failed'
NOTIFY_SMS_ENABLED=false                  # placeholder for Decision 6 — no real SMS client wired

# ─────────────────────────────────────────────
# Admin Module: RBAC, audit log, feature flags, cached aggregates, MFA, impersonation
# ─────────────────────────────────────────────
ADMIN_AUDIT_LOG_RETENTION_DAYS=1825          # 5 years, matches compliance audit-log retention convention
ADMIN_AGGREGATE_CACHE_TTL_SECONDS=300        # Redis TTL for cached admin dashboard aggregates (§4 Decision 3)
ADMIN_DEFAULT_PAGE_SIZE=20                   # Default page size for cursor-paginated admin list endpoints
ADMIN_MAX_PAGE_SIZE=100                      # Hard ceiling a caller cannot exceed via ?limit=
ADMIN_MFA_ISSUER_NAME=Hyrepath Admin         # TOTP provisioning URI issuer label shown in authenticator apps
ADMIN_IMPERSONATION_MAX_DURATION_MINUTES=30  # Hard cap on an impersonation-scoped token's lifetime
PROMETHEUS_QUERY_URL=                        # Optional Prometheus query API base; unset = system-health page shows self-checks only (fail-soft, no error)

# Web push (browser notifications) — generate once via `vapid_gen_keys` (pywebpush) or the
# `py-vapid` CLI. One-time ops step; do not commit real values here.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# ─────────────────────────────────────────────
# Module 2: Tinder-Style Job Board + CV Management
# ─────────────────────────────────────────────
PORTFOLIO_PUBLIC_BASE_URL=https://app.hyrepath.example/p     # matches Decision 4's path-based (not subdomain) hosting
CV_CHAT_MAX_TURNS=12                    # hard cap on chatbot back-and-forth per session (cost + abuse control)
CV_FEEDBACK_MODEL=gpt-4o-mini            # model used by feedback_generator.generate_cv_improvement() (§8.8)
PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_API_BASE=https://api.perplexity.ai
OUTREACH_ENABLED=true
# Required when OUTREACH_ENABLED=true (worker fail-fast via validate_outreach_settings):
# CAN-SPAM requires a physical postal address in every commercial email.
OUTREACH_PHYSICAL_ADDRESS=123 Main St, Suite 100, San Francisco, CA 94105
APP_PUBLIC_BASE_URL=https://app.hyrepath.example      # absolute base URL for links embedded in outbound emails (e.g. privacy policy)
# Company-tier-driven outreach drafting (machine-2/03): off by default, see config.py for rationale.
ENABLE_COMPANY_TIER_IN_OUTREACH_DRAFTING=false
# Demand intelligence -> outreach/resume-tailoring integrations (machine-2/07, /10): off by
# default, additive prompt context, see config.py for rationale. Both also require
# ENABLE_DEMAND_INTELLIGENCE (Module 1's daily aggregation flag, default true) for there to be
# any snapshot data to inject.
ENABLE_DEMAND_INTELLIGENCE_IN_OUTREACH=false
ENABLE_DEMAND_INTELLIGENCE_IN_RESUME_TAILORING=false

# ─────────────────────────────────────────────
# Billing (Stripe) — candidate freemium paywall
# ─────────────────────────────────────────────
# Off by default. ENABLE_BILLING=false is NOT free-tier — everyone is treated
# as premium (no paywall is enforced) until billing is explicitly enabled.
ENABLE_BILLING=false
# STRIPE_MODE=live
# STRIPE_API_BASE=
# Local mock (development only; rejected when APP_ENV is staging or production):
# ENABLE_BILLING=true
# STRIPE_MODE=mock
# STRIPE_SECRET_KEY=sk_test_mock
# STRIPE_WEBHOOK_SECRET=whsec_test_local_secret
# STRIPE_PRICE_ID_PREMIUM=price_mock_premium
# Live / Stripe test-mode keys (STRIPE_MODE=live, default):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PREMIUM=price_...
# Local webhook forwarding: stripe listen --forward-to localhost:8000/api/billing/webhooks/stripe

# ─────────────────────────────────────────────
# Module 3: Interview Prep & Sentiment Analysis
# ─────────────────────────────────────────────
# Voice tone analysis — optional, paid, off by default. Unset -> the frontend
# shows only the free text/rate-based coaching heuristics from
# audio_analysis.py; practice_audio_recordings.voice_tone_signals stays NULL.
# This is a coaching hint feature, not a hire/no-hire signal — see
# phase2_module3.md §3 Decision 4 before enabling.
# HUME_API_KEY=
# HUME_PROSODY_TIMEOUT_SECONDS=30
# Max personalized questions generated per candidate per day (cost control,
# mirrors DAILY_COST_THRESHOLD_USD's intent but scoped to this one feature).
QUESTION_GENERATION_DAILY_LIMIT_PER_USER=10
# Max audio upload size accepted by POST /api/practice/audio before it is even
# sent to Whisper — matches clients/speech.py's own audio file size limit so
# the API rejects oversized files with a clear 4xx instead of a confusing
# Whisper-side error after upload time is already spent.
PRACTICE_AUDIO_MAX_UPLOAD_MB=25
