# ============================================================================
# Hyrepath Enrichment Backend - Production Environment Template
# ============================================================================
# Copy this file to .env.production and fill in your actual values.
# This template is organized by network context and service category.
#
# NETWORK ARCHITECTURE:
# - Bridge network (default): API, Tier 2-4 workers use Docker service names
# - Host network (Tier 1 only): Worker shares namespace with Multilogin
#
# See backend/docker/NETWORKING.md for detailed architecture documentation.
# ============================================================================

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
APP_NAME="Hyrepath Enrichment Backend"
APP_ENV=production

# API authentication token (generate a secure random string)
API_TOKEN=

# ============================================================================
# DATABASE CONFIGURATION (Bridge Network)
# ============================================================================
# Bridge network services use "postgres" as hostname
# Tier 1 worker overrides this to "127.0.0.1" in docker-compose.tier-workers.yml
POSTGRES_USER=hyrepath
POSTGRES_PASSWORD=
POSTGRES_DB=hyrepath

# Default for API and Tier 2-4 workers (bridge network)
DATABASE_URL=postgresql+asyncpg://hyrepath:${POSTGRES_PASSWORD}@postgres:5432/hyrepath

# ============================================================================
# REDIS CONFIGURATION (Bridge Network)
# ============================================================================
# Bridge network default - Tier 1 worker overrides to 127.0.0.1
REDIS_URL=redis://redis:6379/0

# ============================================================================
# WORKER QUEUE CONFIGURATION
# ============================================================================
# Must be "per_tier" when using tier-specific workers
WORKER_QUEUE_MODE=per_tier

# Worker scaling configuration
WORKER_TIER1_COUNT=1
WORKER_TIER234_COUNT=2
WORKER_STARTUP_DELAY=0

# ============================================================================
# CLOUDFLARE R2 STORAGE
# ============================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hyrepath
R2_PUBLIC_BASE_URL=

# ============================================================================
# TIER 1 - LINKEDIN PHOTO SCRAPING
# ============================================================================
# Enable Tier 1 (LinkedIn photo) - requires Multilogin
ENABLE_TIER1=false
BROWSER_MODE=multilogin

# Multilogin credentials
MULTILOGIN_EMAIL=
MULTILOGIN_PASSWORD=
MULTILOGIN_FOLDER_ID=
MULTILOGIN_WORKSPACE_ID=
MULTILOGIN_API_URL=https://api.multilogin.com

# For Linux containerized Multilogin (network_mode: host)
ENABLE_LINUX_MLX=false
MULTILOGIN_LAUNCHER_URL=https://127.0.0.1:45001/api/v2
MULTILOGIN_SELENIUM_HOST=http://127.0.0.1

# LinkedIn bot credentials
LINKEDIN_BOT_EMAIL=
LINKEDIN_BOT_PASSWORD=

# Tier 1 configuration
LINKEDIN_PHOTO_TTL_SECONDS=86400
MULTILOGIN_DAILY_VIEW_LIMIT=20
TIER1_BROWSER_TIMEOUT_SECONDS=90
TIER1_MAX_CONCURRENT=1

# Tier 1 proxy configuration (typically no proxy for LinkedIn)
# Overridden in docker-compose.tier-workers.yml

# ============================================================================
# TIER 2 - HANDLE HUNT (Bridge Network)
# ============================================================================
# Sidecars use service names for bridge network
SOCIAL_ANALYZER_URL=http://social-analyzer:9005

# Sherlock/Maigret timeouts
SHERLOCK_TIMEOUT_SECONDS=60
MAIGRET_TIMEOUT_SECONDS=180

# ============================================================================
# TIER 3 - OSINT + EMAIL (Bridge Network)
# ============================================================================
# GitHub token for gitrecon/theHarvester (free, higher rate limits)
GITHUB_TOKEN=
GITRECON_SCRIPT=/opt/gitrecon/gitrecon.py
GITRECON_MAX_PER_MINUTE=10
GITRECON_RATE_LIMIT_BACKOFF_SECONDS=5
GITRECON_COOLDOWN_SECONDS=60

# Email tools
EMAIL_SLEUTH_BIN=email-sleuth
EMAIL_VERIFIER_URL=http://email-verifier:8080
EMAIL_VERIFY_LEVEL=smtp
EMAIL_VERIFY_MAX_PER_JOB=10
EMAIL_VERIFY_SMTP_DELAY_SECONDS=6

# Reacher SMTP verification (paid)
REACHER_URL=http://reacher:8082
REACHER_FROM_EMAIL=

# CrossLinked configuration
CROSSLINKED_TIMEOUT_SECONDS=120
CROSSLINKED_SEARCH_ENGINES=yahoo

# ============================================================================
# TIER 4 - JOBS + BUSINESS (Bridge Network)
# ============================================================================
GMAPS_SCRAPER_URL=http://google-maps-scraper:8080
GMAPS_JOB_TIMEOUT_SECONDS=300
GMAPS_JOB_POLL_SECONDS=10
JOBSPY_RESULTS_PER_BOARD=15

# ============================================================================
# PROXY CONFIGURATION (External Service)
# ============================================================================
# none | scrapoxy | paid
PROXY_MODE=paid

# Oxylabs proxy (external internet service, works from any network mode)
SCRAPOXY_URL=http://pr.oxylabs.io:7777
SCRAPOXY_USERNAME=
SCRAPOXY_PASSWORD=

# ============================================================================
# LLM DISAMBIGUATION
# ============================================================================
# stub | ollama | litellm
LLM_MODE=litellm

# LiteLLM configuration (bridge network)
LITELLM_API_BASE=http://litellm:4000
LITELLM_API_KEY=
LITELLM_MODEL=gemini/gemini-2.5-flash
LITELLM_FALLBACKS=gemini/gemini-2.5-flash
DISAMBIGUATION_THRESHOLD=0.7

# LLM vendor API keys (passed to litellm container via interpolation)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama configuration (if using)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
# Langfuse (LLM observability)
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DATABASE_URL=postgresql://hyrepath:${POSTGRES_PASSWORD}@postgres:5432/langfuse

# Change detection monitoring
CHANGEDETECTION_URL=http://changedetection:5000
CHANGEDETECTION_API_KEY=
CHANGEDETECTION_PUBLIC_URL=http://localhost:5000
NOTIFY_WEBHOOK_URL=

# Error tracking (GlitchTip self-hosted or Sentry SaaS)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
ENABLE_ERROR_TRACKING_PROBE=false

# GlitchTip configuration
GLITCHTIP_PUBLIC_URL=http://localhost:8001
GLITCHTIP_SECRET_KEY=
GLITCHTIP_DATABASE_URL=postgresql://hyrepath:${POSTGRES_PASSWORD}@postgres:5432/glitchtip

# ============================================================================
# RATE LIMITS & TTLs
# ============================================================================
MAX_SYNC_REQUESTS_PER_MINUTE=10
MAX_ASYNC_REQUESTS_PER_MINUTE=30
MAX_COMPLIANCE_REQUESTS_PER_MINUTE=30

USERNAME_LOOKUP_TTL_SECONDS=3600
BUSINESS_LOOKUP_TTL_SECONDS=3600
JOB_LOOKUP_TTL_SECONDS=1800

# ============================================================================
# COMPLIANCE & AUDIT
# ============================================================================
AUDIT_LOG_RETENTION_YEARS=5

# ============================================================================
# ENRICHER EXECUTION SETTINGS
# ============================================================================
ENRICHER_MAX_RETRIES=3
ENRICHER_RETRY_BACKOFF=2.0
MAX_PARALLEL_TIERS=4
TIER2_MAX_CONCURRENT=3
TIER3_MAX_CONCURRENT=4
TIER4_MAX_CONCURRENT=2

# ============================================================================
# AWS CREDENTIALS (for Linux Multilogin build only)
# ============================================================================
# Only required at build time to pull mlxapp.deb from S3
# Not needed at runtime
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ============================================================================
# NOTES
# ============================================================================
# 1. All bridge network services use Docker service names (postgres, redis, etc.)
# 2. Tier 1 worker overrides these to 127.0.0.1 in docker-compose.tier-workers.yml
# 3. External services (Oxylabs proxy) work from any network mode
# 4. Never commit this file with real secrets - keep it gitignored
# 5. See backend/docker/NETWORKING.md for architecture details
# ============================================================================
