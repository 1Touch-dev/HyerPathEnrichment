# Foundation Week 1 - Document Processing Pipeline
# Template for required environment variables
# Copy values from .env and update as needed

# ============================================================================
# EMBEDDINGS CONFIGURATION
# ============================================================================
ENABLE_EMBEDDINGS=true
OPENAI_API_KEY=sk-proj-...  # Copy from .env
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ============================================================================
# CV EXTRACTION CONFIGURATION
# ============================================================================
CV_EXTRACTION_MODEL=gpt-4o-mini
CV_EXTRACTION_TEMPERATURE=0.1

# ============================================================================
# DOCUMENT UPLOAD CONFIGURATION
# ============================================================================
DOCUMENT_UPLOAD_MAX_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Set R2_ENABLED=false to use local storage for development
R2_ENABLED=false
LOCAL_STORAGE_PATH=.asset-cache

# If R2_ENABLED=true, configure these:
# R2_ACCOUNT_ID=...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# R2_BUCKET=hyrepath
# R2_PUBLIC_BASE_URL=https://pub-....r2.dev

# ============================================================================
# WORKER QUEUE CONFIGURATION
# ============================================================================
WORKER_QUEUE_DOCUMENT=document_processing
WORKER_QUEUE_EMBEDDING=embedding_generation
WORKER_QUEUE_CV_EXTRACTION=cv_extraction

# ============================================================================
# COST MONITORING (OPTIONAL)
# ============================================================================
# Enable cost tracking for OpenAI API calls
ENABLE_COST_TRACKING=true
COST_ALERT_THRESHOLD_USD=100.00

# ============================================================================
# DATABASE (Use existing configuration)
# ============================================================================
# DATABASE_URL=postgresql+asyncpg://hyrepath:password@localhost:5432/hyrepath
# REDIS_URL=redis://localhost:6379/0
