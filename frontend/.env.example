# Server-only (BFF) — never NEXT_PUBLIC_
BACKEND_API_URL=http://localhost:8000

# Must match API_TOKEN in backend/.env
BACKEND_API_TOKEN=change-me

# Optional
# BACKEND_FETCH_TIMEOUT_MS=30000

# Mock mode — BFF returns stubs so the app boots without a backend
# FRONTEND_USE_MOCKS=true

# Public — safe to expose to the browser (VAPID public keys are meant to be
# public; only the matching private key on the backend is secret).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=change-me

# Portfolio subdomain routing (frontend/middleware.ts) — code-only for now, no real
# DNS/wildcard TLS provisioned. Leave unset/false: zero behavior change until ops
# provisions the wildcard cert and flips this on.
# PORTFOLIO_SUBDOMAINS_ENABLED=false
# PORTFOLIO_SUBDOMAIN_ROOT=hyrepath.dev
